            magScanWaitingDialog = false
            Sleep(magScanDelay)
            LogToConsole("`b[`cBen `#x `9Rich`b] `7[`2" .. index .. "`7/`2" .. #mags .. "`7] Scanned Magplant (" .. x .. ", " .. y .. ")")
        end

        if startTileX and startTileY then
