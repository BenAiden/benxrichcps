    for radius = 1, FARM_REMOTE_WRENCH_RANGE do
        for offsetX = -radius, radius do
            for offsetY = -radius, radius do
                if math.abs(offsetX) + math.abs(offsetY) == radius then
                    local standX = (tonumber(x) or 0) + offsetX
                    local standY = (tonumber(y) or 0) + offsetY
                    table.insert(targets, {
                        x = standX,
                        y = standY,
                        distance = GetTileDistance(localX, localY, standX, standY)
                    })
                end
            end
        end
    end
    table.sort(targets, function(a, b) return a.distance < b.distance end)
    return targets
end

