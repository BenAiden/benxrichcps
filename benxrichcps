    if not id then return 0 end
    local ok, res = pcall(function()
        local list = GetObjectList and GetObjectList()
        if not list then return 0 end
        local total = 0
        for _, object in pairs(list) do
            local objId = object and (object.id or object.itemID or object.itemid)
            if objId and tonumber(objId) == tonumber(id) then
                total = total + (tonumber(object.amount or object.count) or 0)
            end
        end
        return total
    end)
    return ok and (res or 0) or 0
end

