function BuildFarmPutCache(baseX, baseY, direction, range)
    local cache = {}
    baseX = tonumber(baseX) or 0
    baseY = tonumber(baseY) or 0
    direction = direction == -1 and -1 or 1
    range = tonumber(range) or 1

    local minX = direction == -1 and (baseX - range) or (baseX + 1)
    local maxX = direction == -1 and (baseX - 1) or (baseX + range)

    if type(GetTile) == "function" then
        for tileX = minX, maxX do
            local ok, tile = pcall(GetTile, tileX, baseY)
            if ok and tile then
                cache[tileX] = tonumber(tile.fg) or 0
            end
        end

        return cache
    end

    for _, tile in pairs(GetTiles and GetTiles() or {}) do
        tileX = tonumber(tile.x)
        tileY = tonumber(tile.y)
        if tileX and tileY == baseY and tileX >= minX and tileX <= maxX then
            cache[tileX] = tonumber(tile.fg) or 0
        end
    end

    return cache
end

function IsFarmPutTileEmpty(tileCache, tileX)
    if not tileCache then
        return true
    end

    return (tonumber(tileCache[tonumber(tileX)]) or 0) == 0
end

function ToFarmDirection(value)
    if value == nil then
        return nil
    end

    if type(value) == "boolean" then
        return value and -1 or 1
    end

    text = string.lower(tostring(value))
    if text:find("left") then
        return -1
    end
    if text:find("right") then
        return 1
    end

    number = tonumber(value)
    if number then
        if number < 0 then
            return -1
        end
        if number > 0 then
            return 1
        end
    end

    return nil
end

function GetLocalFacingDirection()
    local localPlayer = GetLocal()
    if not localPlayer then
        return nil
    end

    fields = {
        "facing", "facingLeft", "facing_left",
        "isLeft", "isleft", "left",
        "direction", "dir", "side"
    }

    for _, field in pairs(fields) do
        direction = ToFarmDirection(localPlayer[field])
        if direction then
            return direction
        end
    end

    return nil
end

function GetFarmDirection()
    local direction = GetLocalFacingDirection()
    if direction then
        farmDirection = direction
    end

    return farmDirection or 1
end

function TrackFarmDirection(packet)
    if not packet then
        return
    end

    packetDirection = ToFarmDirection(packet.direction or packet.dir or packet.facing or packet.side)
    if packetDirection then
        farmDirection = packetDirection
        return
    end

    if packet.type == 3 and packet.px then
        currentX = GetLocalTile()
        packetX = tonumber(packet.px)
        if packetX and packetX < currentX then
            farmDirection = -1
        elseif packetX and packetX > currentX then
            farmDirection = 1
        end
    end

    if packet.x then
        rawX = PositionToTile(packet.x)
        if farmLastRawX and rawX ~= farmLastRawX then
            farmDirection = rawX < farmLastRawX and -1 or 1
        end
        farmLastRawX = rawX
    end
end

