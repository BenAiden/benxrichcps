        if IsMagplantTile(tile) and (bgSearch == 0 or tonumber(tile.bg) == tonumber(bgSearch)) then
            local tileX = tonumber(tile.x)
            local tileY = tonumber(tile.y)
            local key = GetFarmRemoteTargetKey(tileX, tileY)
            if not farmRemoteBlockedMagplants[key] then
                local distance = math.abs((tileX or 0) - localX) + math.abs((tileY or 0) - localY)
                table.insert(targets, { x = tileX, y = tileY, distance = distance, key = key })
            end
        end
    end
    table.sort(targets, function(a, b)
        if a.y == b.y then
            return a.x < b.x
        end
        return a.y < b.y
    end)
    return targets
end

function TryTakeFarmRemote(x, y, allowMoveNear)
    local targetKey = GetFarmRemoteTargetKey(x, y)

    if allowMoveNear == true then
        TextOverlay("`6[V1 FARM] Moving near Magplant.")
        if not MoveNearFarmRemote(x, y) then
            return false, "too-far"
        end
        Sleep(300)
    end

    local opened, reason = TryOpenFarmRemoteDialog(x, y)

    if not opened then
        if reason == "no-access" or reason == "empty" then
            farmRemoteBlockedMagplants[targetKey] = true
        end
        return false, reason
    end

    farmRemoteWaitingDialog = true
    farmRemoteDialogNoAccess = false
    farmRemoteDialogTooFar = false
    local dName = farmRemoteDialogName or "magplant_edit"
    local dx = farmRemoteDialogX or x
    local dy = farmRemoteDialogY or y
    SendPacket(2, "action|dialog_return\ndialog_name|" .. dName .. "\nx|" .. dx .. "|\ny|" .. dy .. "|\nbuttonClicked|getRemote\n")
    SendPacket(2, "action|dialog_return\ndialog_name|magplant_edit\nx|" .. x .. "|\ny|" .. y .. "|\nbuttonClicked|getRemote\n")
    
    local wait = 0
    while getItemCount(MAGPLANT_REMOTE_ID) <= 0 and not farmRemoteDialogNoAccess and wait < 20 do
        Sleep(100)
        wait = wait + 1
    end
    farmRemoteWaitingDialog = false

    if farmRemoteDialogNoAccess then
        farmRemoteBlockedMagplants[targetKey] = true
        return false, "no-access"
    end

    if SetItemSelected then
        pcall(SetItemSelected, MAGPLANT_REMOTE_ID)
    end

    if getItemCount(MAGPLANT_REMOTE_ID) > 0 then
        LogToConsole("`b[`cBen `#x `9Rich`b] `2Successfully obtained Magplant remote from (" .. x .. ", " .. y .. ")!")
        return true, "ok"
    end
    return false, "no-remote"
end

function RequestFarmRemote(force)
    if farmRemoteRunning then return end
    if not farmAutoRemote and not force then return end

    farmRemoteRunning = true
    RunThread(function()
        targets = GetFarmRemoteTargets()
        if #targets == 0 then
            TextOverlay("`4[V1 FARM] No accessible Magplant found.")
            LogToConsole("`b[`cBen `#x `9Rich`b] `4[V1 Remote] No accessible Magplant found.")
            farmRemoteRunning = false
            return
        end

        TextOverlay("`9[V1 FARM] Moving to Magplant for Remote...")
        for _, target in pairs(targets) do
            if not farmRunning then break end
            local success, reason = TryTakeFarmRemote(target.x, target.y, true)
            if success then
                TextOverlay("`2[V1 FARM] Remote updated.")
                farmRemoteRunning = false
                return
            else
                LogToConsole("`b[`cBen `#x `9Rich`b] `4[V1 Remote] Magplant (" .. target.x .. ", " .. target.y .. ") failed: " .. tostring(reason))
            end
            Sleep(200)
        end

        TextOverlay("`4[V1 FARM] Could not obtain Magplant remote.")
        farmRemoteRunning = false
    end)
end

function WaitForFarmRemote()
    if getItemCount(MAGPLANT_REMOTE_ID) > 0 and not farmRemoteRunning then return end

    RequestFarmRemote(true)

    local wait = 0
    while farmRemoteRunning and getItemCount(MAGPLANT_REMOTE_ID) <= 0 and wait < 80 do
        Sleep(100)
        wait = wait + 1
    end
end

function ToFarmItemId(value)
    if type(value) == "table" then
        return ToFarmItemId(value.id or value.itemID or value.itemId or value.itemid or value.value)
    end
    id = tonumber(value)
    if id and id ~= 0 then return id end
    return nil
end

function GetHeldItemId()
    local playerInfo = nil
    if GetPlayerInfo then
        local ok, result = pcall(GetPlayerInfo)
        if ok then playerInfo = result end
    elseif GetPlayerItems then
        local ok, result = pcall(GetPlayerItems)
        if ok then playerInfo = result end
    end

    if playerInfo then
        selected = nil
        if playerInfo.backpack then selected = playerInfo.backpack.selected end
        selected = selected or playerInfo.selected or playerInfo.itemID or playerInfo.itemid
        selectedId = ToFarmItemId(selected)
        if selectedId and getItemCount(selectedId) > 0 then return selectedId end
    end

    localPlayer = GetLocal and GetLocal()
    if not localPlayer then return nil end

    fields = { "itemID", "itemId", "itemid", "selectedItem", "selected_item", "currentItem", "current_item", "heldItem", "heldItemID", "held_item", "handItem", "hand", "value" }
    for _, field in pairs(fields) do
        id = ToFarmItemId(localPlayer[field])
        if id and getItemCount(id) > 0 then return id end
    end
    return nil
end

function SetFarmItem(id)
    id = tonumber(id)
    if id and id ~= 0 and getItemCount(id) > 0 then
        farmItem = id
        farmSelectingItem = false
        SaveFarmState()
        TextOverlay("`2[V1 FARM] Item selected: `#" .. farmItem)
        ShowFarmMenuV1()
        return true
    end
    return false
end

function StartFarmItemSelect()
    farmSelectingItem = true
    farmSelectOldItem = GetHeldItemId()
    TextOverlay("`9[V1 FARM] Tap the item in your backpack now.")

    if farmSelectThreadRunning then return end
    farmSelectThreadRunning = true
    RunThread(function()
        if SetItemSelected and getItemCount(WRENCH_ID) > 0 then
            pcall(SetItemSelected, WRENCH_ID)
            Sleep(150)
            farmSelectOldItem = GetHeldItemId() or WRENCH_ID
        end

        tries = 0
        while farmSelectingItem and tries < 200 do
            heldItem = GetHeldItemId()
            if heldItem and heldItem ~= farmSelectOldItem then
                if SetFarmItem(heldItem) then
                    farmSelectThreadRunning = false
                    return
                end
            end
            Sleep(100)
            tries = tries + 1
        end

        farmSelectThreadRunning = false
        if farmSelectingItem then
            farmSelectingItem = false
            TextOverlay("`6[V1 FARM] Item select timed out.")
            ShowFarmMenuV1()
        end
    end)
end

function StartAutoFarmV1()
    SelectedFarmVersion = "V1"
    if not farmX or not farmY then
        TextOverlay("`4[V1 FARM] Set position first.")
        return
    end

    if not farmItem then
        TextOverlay("`4[V1 FARM] Select an item first.")
        return
    end

    if not farmWorld or farmWorld == "" then
        farmWorld = GetCurrentWorldName()
    end

    if farmItem == 5640 or (farmRemoteBgId and farmRemoteBgId > 0) then
        farmAutoRemote = true
    end

    if ScriptRunning then
        pcall(StopPNB)
        ScriptRunning = false
        StopRequested = true
        TextOverlay("`6[FARM] V2 stopped automatically (only 1 engine can run).")
        LogToConsole("`b[`cBen `#x `cRich`b] `6[FARM] Auto-stopped V2 before starting V1.")
    end

    farmRunning = true
    farmPositionConfirm = 0
    farmLastWorld = nil
    farmReconnectWait = FARM_START_WAIT
    farmJoinWait = 0
    farmDetectWait = 0
    farmNextOffset = 1
    farmWaitingBreak = false
    farmBreakWait = 0
    farmRemoteBlockedMagplants = {}
    
    farmStartTime = os.time()
    farmLastWebhookTime = os.time()
    local bgl_count = 0
    local dl_count = 0
    if type(inv) == "function" then
        bgl_count = inv(7188) or 0
        dl_count = inv(1796) or 0
    end
    farmStartTotalLocks = (bgl_count * 100) + dl_count
    BEN_FARM_STATE.lastStopReason = nil
    SaveFarmState()
    TextOverlay("`2[Ben x Rich V1] PNB Farm Started.")
    LogToConsole("`b[`cBen `#x `cRich`b] `2[V1 Farm] Started in " .. tostring(farmWorld) .. " at (" .. farmX .. ", " .. farmY .. ")")

    if farmWebhookUrl and farmWebhookUrl ~= "" then
        RunThread(function() pcall(SendInfoPNB_V1, "Started V1 Auto Farm in world " .. tostring(farmWorld)) end)
    end

    if farmThreadRunning then return end

    farmThreadRunning = true
    RunThread(function()
        if ChangeValue then
            ChangeValue("[C] Ghost mode", not farmPublicPNB)
        end
        -- if farmPublicPNB or PublicPNB then
        --     local startX, startY = GetLocalTile()
        --     SendPacket(2, "action|respawn\n")
        --     local waitTries = 0
        --     while waitTries < 50 do
        --         local curX, curY = GetLocalTile()
        --         if curX ~= startX or curY ~= startY then break end
        --         Sleep(100)
        --         waitTries = waitTries + 1
        --     end
        --     Sleep(1500)
        -- end
        lastConsumeCheck = os.time()
        local isDisconnected = false
        local isWrongWorld = false
        farmHasStartedFarming = false
        
        while farmRunning and _G.BEN_CPS_SESSION == BEN_CPS_SESSION do
            currentWorld = GetCurrentWorldName()
            if farmLastWorld == nil then
                farmLastWorld = currentWorld
            elseif currentWorld ~= farmLastWorld then
                farmLastWorld = currentWorld
                MarkFarmUnsafe(FARM_WORLD_WAIT)
                Sleep(500)
            end

            if currentWorld == "" or currentWorld == "EXIT" then
                if not isDisconnected then
                    isDisconnected = true
                    isWrongWorld = false
                    farmHasStartedFarming = false
                    if farmWebhookUrl and farmWebhookUrl ~= "" then
                        RunThread(function() pcall(SendInfoPNB_V1, "Disconnected from the server! Waiting to reconnect...", true) end)
                    end
                end
                MarkFarmUnsafe(FARM_WORLD_WAIT)
                if farmWorld and farmWorld ~= "" then
                    if farmJoinWait <= 0 then
                        SafeJoin(farmWorld)
                        farmJoinWait = FARM_JOIN_RETRY_WAIT
                    else
                        farmJoinWait = farmJoinWait - 1
                    end
                end
                Sleep(1000)
            elseif farmWorld and farmWorld ~= "" and currentWorld:upper() ~= farmWorld:upper() then
                if not isWrongWorld then
                    isWrongWorld = true
                    farmHasStartedFarming = false
                    if farmWebhookUrl and farmWebhookUrl ~= "" then
                        RunThread(function() pcall(SendInfoPNB_V1, "You left the farm world! Rejoining " .. tostring(farmWorld) .. "...", true) end)
                    end
                end
                MarkFarmUnsafe(FARM_WORLD_WAIT)
                if farmJoinWait <= 0 then
                    SafeJoin(farmWorld)
                    farmJoinWait = FARM_JOIN_RETRY_WAIT
                else
                    farmJoinWait = farmJoinWait - 1
                end
                Sleep(2000)
            else
                if isDisconnected or isWrongWorld then
                    isDisconnected = false
                    isWrongWorld = false
                    if farmWebhookUrl and farmWebhookUrl ~= "" then
                        RunThread(function() pcall(SendInfoPNB_V1, "Successfully joined the world! Resuming V1 Auto Farm...", true) end)
                    end
                end
                farmJoinWait = 0
                if not farmItem or not farmX or not farmY then
                    StopAutoFarmWithReason("missing setup")
                    break
                end

                canFarm = true
                currentX, currentY = GetLocalTile()
                if farmDetectWait > 0 then
                    farmDetectWait = farmDetectWait - 1
                    canFarm = false
                elseif farmAutoRemote and farmRemoteRunning then
                    Sleep(500)
                    canFarm = false
                elseif farmAutoRemote and getItemCount(MAGPLANT_REMOTE_ID) <= 0 then
                    WaitForFarmRemote()
                    if getItemCount(MAGPLANT_REMOTE_ID) <= 0 then
                        Sleep(500)
                        canFarm = false
                    end
                elseif not farmRemoteRunning and (currentX ~= farmX or currentY ~= farmY) then
                    farmPositionConfirm = 0
                    farmWaitingBreak = false
                    farmBreakWait = 0
                    FarmTeleportToSavedPosition()
                    canFarm = false
                elseif farmReconnectWait > 0 then
                    if farmReconnectWait > FARM_START_WAIT then
                        farmReconnectWait = 0
                        farmPositionConfirm = FARM_STABLE_REQUIRED
                    else
                        farmReconnectWait = farmReconnectWait - 1
                        Sleep(120)
                        canFarm = false
                    end
                elseif farmPositionConfirm < FARM_STABLE_REQUIRED then
                    farmPositionConfirm = farmPositionConfirm + 1
                    Sleep(120)
                    canFarm = false
                end

                if canFarm then
                    if not farmHasStartedFarming then
                        farmHasStartedFarming = true
                        if farmWebhookUrl and farmWebhookUrl ~= "" then
                            RunThread(function() pcall(SendInfoPNB_V1, "Arrived at (" .. tostring(farmX) .. ", " .. tostring(farmY) .. ")! Now Farming!", true) end)
                        end
                    end
                    -- Auto Consume integration for V1
                    if farmAutoConsume and (os.time() - lastConsumeCheck > 20) then
                        lastConsumeCheck = os.time()
                        pcall(CheckAutoConsume)
                    end
                    
                    -- Webhook integration for V1
                    if farmWebhookUrl and farmWebhookUrl ~= "" and (os.time() - (farmLastWebhookTime or 0) >= 300) then
                        farmLastWebhookTime = os.time()
                        RunThread(function()
                            pcall(SendInfoPNB_V1)
                        end)
                    end

                    local isVertical = (farmVerticalPNB or VerticalPNB) == true
                    direction = GetFarmDirection()
                    if (farmMirrorPNB or MirrorPNB) then
                        direction = -1
                    end
                    putCache = BuildFarmPutCache(farmX, farmY, direction, farmRange, isVertical)

                    rowReady = true
                    for offset = 1, farmRange do
                        local checkKey = isVertical and (farmY - offset) or (farmX + (offset * direction))
                        local checkY = isVertical and (farmY - offset) or farmY
                        if IsFarmPutTileEmpty(putCache, checkKey, checkY) then
                            rowReady = false
                            break
                        end
                    end

                    if farmWaitingBreak then
                        if rowReady and farmBreakWait > 0 then
                            farmBreakWait = farmBreakWait - 1
                        else
                            farmWaitingBreak = false
                            farmBreakWait = 0
                        end
                    elseif not rowReady then
                        for _ = 1, farmRange do
                            if not farmRunning then break end
                            if not IsFarmLocationReady() then
                                MarkFarmUnsafe(FARM_MOVE_WAIT)
                                break
                            end
                            offset = farmNextOffset
                            farmNextOffset = farmNextOffset + 1
                            if farmNextOffset > farmRange then
                                farmNextOffset = 1
                            end
                            targetX = isVertical and farmX or (farmX + (offset * direction))
                            targetY = isVertical and (farmY - offset) or farmY
                            local checkKey = isVertical and targetY or targetX
                            if IsFarmPutTileEmpty(putCache, checkKey, targetY) then
                                if SendFarmTilePacket(farmItem, targetX, targetY) then
                                    putCache[checkKey] = farmItem
                                end
                                if FARM_PUT_DELAY > 0 then
                                    Sleep(FARM_PUT_DELAY)
                                end
                                break
                            end
                        end
                    elseif farmRunning and IsFarmLocationReady() then
                        local punchX = isVertical and farmX or (farmX + direction)
                        local punchY = isVertical and (farmY - 1) or farmY
                        SendFarmTilePacket(18, punchX, punchY)
                        farmNextOffset = 1
                        farmWaitingBreak = true
                        farmBreakWait = FARM_BREAK_CONFIRM_WAIT
                        if FARM_PUNCH_DELAY > 0 then
                            Sleep(FARM_PUNCH_DELAY)
                        end
                    end
                end
            end
            Sleep(80)
        end
        if _G.BEN_CPS_SESSION == BEN_CPS_SESSION and farmRunning then
            StopAutoFarmWithReason("thread ended", false)
        end
        farmThreadRunning = false
    end)
end

