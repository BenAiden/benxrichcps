    if GetInventory then
        for _, itm in pairs(GetInventory()) do
            if itm.id == id then return itm.amount end
        end
    end
    return 0
end

function ParseTrashIDList(str)
    local ids = {}
    for idStr in tostring(str or ""):gmatch("%d+") do
        local num = tonumber(idStr)
