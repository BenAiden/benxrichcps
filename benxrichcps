function ExtractFastDropItemId(str)
    if type(str) ~= "string" then
        return nil
    end

    patterns = {
        "itemID|(-?%d+)",
        "itemId|(-?%d+)",
        "itemid|(-?%d+)",
        "item_id|(-?%d+)",
        "item_drop|(-?%d+)",
        "selectedItem|(-?%d+)",
        "selected_item|(-?%d+)",
        "currentItem|(-?%d+)",
        "current_item|(-?%d+)",
        "heldItem|(-?%d+)",
        "held_item|(-?%d+)",
        "value|(-?%d+)"
    }

    for _, pattern in pairs(patterns) do
        id = tonumber(str:match(pattern))
        if id and id ~= 0 then
            return id
        end
    end

    return GetHeldItemId()
end

function ExtractFastDropAmount(str)
    if type(str) ~= "string" then
        return 0
    end

    patterns = {
        "item_count|(%d+)",
        "itemCount|(%d+)",
        "item_amount|(%d+)",
        "count|(%d+)",
        "amount|(%d+)",
        "qty|(%d+)",
        "quantity|(%d+)"
    }

    for _, pattern in pairs(patterns) do
        amount = tonumber(str:match(pattern))
        if amount and amount > 0 then
            return amount
        end
    end

    return 0
end

function ExtractFastDropDialogItemId(dialog)
    if type(dialog) ~= "string" then
        return nil
    end

    fromField = GetDialogField(dialog, "item_drop")
    if fromField and tostring(fromField) ~= "" then
        return tostring(fromField)
    end

    patterns = {
        "item_drop|(-?%d+)",
        "itemID|(-?%d+)",
        "itemId|(-?%d+)",
        "itemid|(-?%d+)",
        "value|(-?%d+)"
    }

    for _, pattern in pairs(patterns) do
        id = dialog:match(pattern)
        if id and id ~= "0" then
            return id
        end
    end

    return nil
end

function ExtractFastDropDialogAmount(dialog, itemId)
    local amount = getItemCount(itemId)
    if amount and amount > 0 then
        return amount
    end

    amount = ExtractFastDropAmount(dialog)
    if amount and amount > 1 then
        return amount
    end

    cleanDialog = Filter(dialog or "")
    if itemId then
        cleanDialog = cleanDialog:gsub(tostring(itemId), "")
        cleanDialog = cleanDialog:gsub(tostring(math.abs(tonumber(itemId) or 0)), "")
    end

    best = 0
    for number in cleanDialog:gmatch("%d+") do
        value = tonumber(number)
        if value and value > best then
            best = value
        end
    end

    if best > 1 then
        return best
    end

    return FAST_DROP_FALLBACK_AMOUNT
end

function SubmitFastDrop(itemId, amount)
    if not itemId or tostring(itemId) == "" then
        return false
    end

    amount = tonumber(amount) or 0
    if amount <= 0 then
        amount = FAST_DROP_FALLBACK_AMOUNT
    end

    SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. tostring(itemId) .. "|\nitem_count|" .. amount)
    TextOverlay("`2[DROP] Fast dropped `#" .. amount .. " `2item(s).")
    return true
end

function FastDropDialog(dialog)
    if not fastDropEnabled or not fastDropDialogPending or type(dialog) ~= "string" or not dialog:find("dialog_name|drop") then
        return false
    end

    itemId = ExtractFastDropDialogItemId(dialog)
    if not itemId then
        fastDropDialogPending = false
        return false
    end

    amount = ExtractFastDropDialogAmount(dialog, itemId)
    fastDropDialogPending = false
    return SubmitFastDrop(itemId, amount)
end

function FastDropHeldItem(str)
    if type(str) ~= "string" or not str:find("action|drop") then
        return false
    end

    itemId = ExtractFastDropItemId(str)
    if not itemId then
        fastDropDialogPending = true
        return false
    end

    _, amount = FindInventoryItemStack(itemId)
    if amount <= 0 then
        amount = ExtractFastDropAmount(str)
    end
    if amount <= 0 then
        amount = FAST_DROP_FALLBACK_AMOUNT
    end

    fastDropDialogPending = false
    return SubmitFastDrop(itemId, amount)
end

