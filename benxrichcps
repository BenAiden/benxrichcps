        parts[#parts + 1] = emoji .. " :"
    end

    local color = ""
    if benMenuTextColor then
        color = benMenuFixedColor
        if color == "" then
            color = "`" .. BEN_MENU_COLORS[math.random(#BEN_MENU_COLORS)]
        end
    end

    local newText = table.concat(parts, " ")
    if newText ~= "" then
        newText = newText .. " "
    end
    newText = newText .. color .. text
    SendPacket(2, prefix .. newText)
    return true
