function StartAutoPullMonitor()
    if autoPullThreadRunning then
        return
    end

    autoPullThreadRunning = true
    RunThread(function()
        while autoPull and _G.BEN_CPS_SESSION == BEN_CPS_SESSION do
            currentWorld = GetCurrentWorldName()
            if currentWorld ~= autoPullWorld then
                SeedAutoPullKnownPlayers()
            end

            ok, players = pcall(GetPlayerList)
            if ok and type(players) == "table" then
                for _, player in pairs(players) do
                    key = GetAutoPullPlayerKey(player)
                    if key and not autoPullKnownPlayers[key] then
                        autoPullKnownPlayers[key] = true
                        if not IsLocalPlayerEntry(player) then
                            AutoPullPlayer(player)
                            Sleep(250)
                        end
                    end
                end
            end

            Sleep(500)
        end

        autoPullThreadRunning = false
    end)
end

