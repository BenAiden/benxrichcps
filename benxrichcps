function StartChampagneBuyLoop(dialog)
    if dialog then
        champLastDialog = dialog
        lastTelephoneX = GetDialogField(dialog, "x") or lastTelephoneX
        lastTelephoneY = GetDialogField(dialog, "y") or lastTelephoneY
        lastTelephoneNum = CHAMPAGNE_PHONE_NUMBER
    end

    if not buycemp then
        return
    end

    if not lastTelephoneX or not lastTelephoneY then
        TextOverlay("`6[CHAMP] Wrench Telephone once to start.")
        return
    end

    if champBuyThreadRunning then
        return
    end

    NormalizeChampagneSettings()
    champBuyThreadRunning = true
    RunThread(function()
        while buycemp and _G.BEN_CPS_SESSION == BEN_CPS_SESSION and champBoughtCount < champTargetCount do
            if not EnsureChampagneDl() then
                buycemp = false
                TextOverlay("`4[CHAMP] Not enough. Need 20 DL, BGL, or BBGL.")
                break
            end

            if not SendTelephoneReturn("getchamp", CHAMPAGNE_PHONE_NUMBER, lastTelephoneX, lastTelephoneY) then
                buycemp = false
                break
            end

            champBoughtCount = champBoughtCount + 1
            SaveChampagneState()
            TextOverlay("`2[CHAMP] Buying `#" .. champBoughtCount .. "`w/`#" .. champTargetCount)

            waited = 0
            while buycemp and _G.BEN_CPS_SESSION == BEN_CPS_SESSION and waited < champDelay do
                Sleep(50)
                waited = waited + 50
            end
        end

        if _G.BEN_CPS_SESSION == BEN_CPS_SESSION then
            if buycemp and champBoughtCount >= champTargetCount then
                buycemp = false
                TextOverlay("`2[CHAMP] Completed `#" .. champBoughtCount .. " `2buy attempt(s).")
            end
            SaveChampagneState()
        end

        champBuyThreadRunning = false
    end)
end

