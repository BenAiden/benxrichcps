function BuildFarmPutCache(originX, originY, direction, range, isVertical)
    local cache = {}
    originX = tonumber(originX) or 0
    originY = tonumber(originY) or 0
    direction = tonumber(direction) or 1
    range = tonumber(range) or 1

    if isVertical then
        for offset = 1, range do
            local ty = originY - offset
            if type(GetTile) == "function" then
                local ok, tile = pcall(GetTile, originX, ty)
                if ok and tile then
                    cache[ty] = tonumber(tile.fg) or 0
                else
                    cache[ty] = 0
                end
            else
                cache[ty] = 0
            end
        end
        return cache
    end

    local minX = originX + (1 * direction)
    local maxX = originX + (range * direction)
    if minX > maxX then
        minX, maxX = maxX, minX
    end

    if type(GetTile) == "function" then
        for tileX = minX, maxX do
            local ok, tile = pcall(GetTile, tileX, originY)
            if ok and tile then
                cache[tileX] = tonumber(tile.fg) or 0
            end
        end
        return cache
    end

    local tiles = (GetTiles and GetTiles()) or {}
    for _, tile in pairs(tiles) do
        local tx = tonumber(tile.x) or 0
        local ty = tonumber(tile.y) or 0
        if ty == originY and tx >= minX and tx <= maxX then
            cache[tx] = tonumber(tile.fg) or 0
        end
    end
    return cache
end

