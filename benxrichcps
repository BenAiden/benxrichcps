function GetLocalTile()
    local localPlayer = GetLocal()
    local x = 0
    local y = 0
    if localPlayer then
        if localPlayer.pos then
            x = math.floor((tonumber(localPlayer.pos.x or localPlayer.posX or localPlayer.x or 0) or 0) / 32)
            y = math.floor((tonumber(localPlayer.pos.y or localPlayer.posY or localPlayer.y or 0) or 0) / 32)
        else
            local rawX = tonumber(localPlayer.posX or localPlayer.x or 0) or 0
            local rawY = tonumber(localPlayer.posY or localPlayer.y or 0) or 0
            x = rawX > 100 and math.floor(rawX / 32) or math.floor(rawX)
            y = rawY > 100 and math.floor(rawY / 32) or math.floor(rawY)
        end
    end
    return x, y
end

function GetPlayerTile(player)
    if not player then
        return nil, nil, nil, nil
    end

    local x = nil
    local y = nil
    if player.pos then
        x = player.pos.x or player.posX or player.x
        y = player.pos.y or player.posY or player.y
    else
        x = player.posX or player.x
        y = player.posY or player.y
    end

    if x == nil or y == nil then
        return nil, nil, nil, nil
    end

    return PositionToTile(x), PositionToTile(y), math.floor(x), math.floor(y)
end

function IsLocalPlayerEntry(player)
    local localPlayer = GetLocal()
    if not player or not localPlayer then
        return false
    end

    if player.netID and localPlayer.netID and tonumber(player.netID) == tonumber(localPlayer.netID) then
        return true
    end

    if player.userid and localPlayer.userid and tonumber(player.userid) == tonumber(localPlayer.userid) then
        return true
    end

    return player.name and localPlayer.name and Filter(player.name) == Filter(localPlayer.name)
end

function IsBlueTrollIgnoredPlayer(player)
    if not player or not player.name then
        return false
    end

    cleanName = string.lower(Filter(player.name))
    return cleanName:find("spammer slave") ~= nil
end

function GetBlueTrollTargetKey(player, tileX, tileY)
    local id = player.netID or player.userid or player.userID
    if id then
        return "id:" .. tostring(id)
    end

    if player.name then
        name = Filter(player.name)
        if name ~= "" then
            return "name:" .. name
        end
    end

    return "tile:" .. tostring(tileX) .. "," .. tostring(tileY)
end

function BuildBlueTrollTargets()
    local targets = {}
    local seen = {}
    local localX, localY = GetLocalTile()

    for _, player in pairs(GetPlayerList and GetPlayerList() or {}) do
        if not IsLocalPlayerEntry(player) and not IsBlueTrollIgnoredPlayer(player) then
            local targetX, targetY, pixelX, pixelY = GetPlayerTile(player)
            if targetX and targetY then
                local key = GetBlueTrollTargetKey(player, targetX, targetY)
                if key and not seen[key] then
                    seen[key] = true
                    local distance = math.abs(targetX - localX) + math.abs(targetY - localY)
                    table.insert(targets, { x = targetX, y = targetY, pixelX = pixelX, pixelY = pixelY, key = key, distance = distance })
                end
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.distance < b.distance
    end)

    return targets
end

function FindBlueTrollTarget(targetKey)
    for _, player in pairs(GetPlayerList and GetPlayerList() or {}) do
        if not IsLocalPlayerEntry(player) and not IsBlueTrollIgnoredPlayer(player) then
            local targetX, targetY, pixelX, pixelY = GetPlayerTile(player)
            if targetX and targetY then
                local key = GetBlueTrollTargetKey(player, targetX, targetY)
                if key == targetKey then
                    return { x = targetX, y = targetY, pixelX = pixelX, pixelY = pixelY, key = key }
                end
            end
        end
    end

    return nil
end

function AddBlueTrollOffset(offsets, seen, x, y)
    local key = tostring(x) .. "," .. tostring(y)
    if not seen[key] then
        seen[key] = true
        table.insert(offsets, { x = x, y = y })
    end
end

function GetBlueTrollLead(liveTarget, previousTarget, originalTarget)
    local leadX = 0
    local leadY = 0

    if previousTarget then
        local deltaX = (liveTarget.pixelX or (liveTarget.x * 32)) - (previousTarget.pixelX or (previousTarget.x * 32))
        local deltaY = (liveTarget.pixelY or (liveTarget.y * 32)) - (previousTarget.pixelY or (previousTarget.y * 32))
        if deltaX > 4 then
            leadX = 1
        elseif deltaX < -4 then
            leadX = -1
        end

        if deltaY > 4 then
            leadY = 1
        elseif deltaY < -4 then
            leadY = -1
        end
    end

    if leadX == 0 and originalTarget then
        if liveTarget.x > originalTarget.x then
            leadX = 1
        elseif liveTarget.x < originalTarget.x then
            leadX = -1
        end
    end

    if leadY == 0 and originalTarget then
        if liveTarget.y > originalTarget.y then
            leadY = 1
        elseif liveTarget.y < originalTarget.y then
            leadY = -1
        end
    end

    return leadX, leadY
end

function GetBlueTrollOffsets(leadX, leadY)
    local offsets = {}
    local seen = {}

    AddBlueTrollOffset(offsets, seen, leadX, leadY)
    AddBlueTrollOffset(offsets, seen, leadX * 2, leadY)
    AddBlueTrollOffset(offsets, seen, leadX, leadY + 1)
    AddBlueTrollOffset(offsets, seen, leadX, leadY - 1)
    AddBlueTrollOffset(offsets, seen, leadX + 1, leadY)
    AddBlueTrollOffset(offsets, seen, leadX - 1, leadY)
    AddBlueTrollOffset(offsets, seen, 0, 0)
    AddBlueTrollOffset(offsets, seen, 1, 0)
    AddBlueTrollOffset(offsets, seen, -1, 0)
    AddBlueTrollOffset(offsets, seen, 0, 1)
    AddBlueTrollOffset(offsets, seen, 0, -1)
    AddBlueTrollOffset(offsets, seen, 2, 0)
    AddBlueTrollOffset(offsets, seen, -2, 0)

    return offsets
end

function AddBlueTrollReason(reasonCounts, reason)
    reason = reason or "no-consume"
    reasonCounts[reason] = (reasonCounts[reason] or 0) + 1
end

function GetBlueTrollReasonText(reasonCounts)
    local parts = {}
    local order = { "not-person", "too-far", "no-consume", "left", "empty" }

    for _, reason in ipairs(order) do
        if reasonCounts[reason] and reasonCounts[reason] > 0 then
            table.insert(parts, reason .. ":" .. reasonCounts[reason])
        end
    end

    if #parts == 0 then
        return ""
    end

    return " `6reason: " .. table.concat(parts, " ")
end

function TryBlueTrollTarget(target, itemId)
    local previousTarget = FindBlueTrollTarget(target.key)
    if not previousTarget then
        return false, "left", 0
    end

    tries = 0
    missReason = nil
    while tries < 10 do
        liveTarget = FindBlueTrollTarget(target.key)
        if not liveTarget then
            return false, "left", tries
        end

        leadX, leadY = GetBlueTrollLead(liveTarget, previousTarget, target)
        offsets = GetBlueTrollOffsets(leadX, leadY)

        for _, offset in ipairs(offsets) do
            if tries >= 10 then
                break
            end

            beforeCount = getItemCount(itemId)
            if beforeCount <= 0 then
                return false, "empty", tries
            end

            blueTrollLastMissReason = nil
            SendTileUsePacket(itemId, liveTarget.x + offset.x, liveTarget.y + offset.y, liveTarget.pixelX + (offset.x * 32), liveTarget.pixelY + (offset.y * 32))
            tries = tries + 1
            Sleep(BLUE_TROLL_TILE_DELAY)

            if getItemCount(itemId) < beforeCount then
                return true, "used", tries
            end

            if blueTrollLastMissReason then
                missReason = blueTrollLastMissReason
            end
        end

        previousTarget = liveTarget
    end

    return false, missReason or "no-consume", tries
end

function RunItemTrollWorld(itemId, itemName, tag)
    if blueTrollRunning then
        TextOverlay("`6[" .. tag .. "] Troll is already running.")
        return
    end

    startCount = getItemCount(itemId)
    if startCount <= 0 then
        TextOverlay("`4[" .. tag .. "] You need " .. itemName .. " first.")
        return
    end

    targets = BuildBlueTrollTargets()
    if #targets == 0 then
        TextOverlay("`4[" .. tag .. "] No valid players found.")
        return
    end

    planned = math.min(#targets, startCount)
    TextOverlay("`9[" .. tag .. "] Starting " .. itemName .. " use on `#" .. planned .. " `9target(s).")

    RunThread(function()
        blueTrollRunning = true
        blueTrollLastMissReason = nil
        attempts = 0
        usedPlayers = 0
        reasonCounts = {}
        for _, target in pairs(targets) do
            if getItemCount(itemId) <= 0 then
                break
            end

            success, reason, tries = TryBlueTrollTarget(target, itemId)
            attempts = attempts + tries
            if success then
                usedPlayers = usedPlayers + 1
            else
                AddBlueTrollReason(reasonCounts, reason)
            end

            Sleep(BLUE_TROLL_DELAY)
        end

        Sleep(500)
        blueTrollRunning = false
        used = startCount - getItemCount(itemId)
        reasonText = GetBlueTrollReasonText(reasonCounts)
        if used > 0 then
            TextOverlay("`9[" .. tag .. "] Used `#" .. used .. " `9" .. itemName .. " on `#" .. usedPlayers .. " `9player(s) from `#" .. attempts .. " `9try(s)." .. reasonText)
        else
            TextOverlay("`4[" .. tag .. "] No " .. itemName .. " items were used from `#" .. attempts .. " `4try(s)." .. reasonText)
        end
    end)
end

