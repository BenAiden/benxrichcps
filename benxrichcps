function TranslateText(text, srcLang, tgtLang)
    if not text or text == "" then return nil end
    srcLang = srcLang or "auto"
    tgtLang = tgtLang or "id"

    local cleanText = tostring(text):gsub("[\r\n]", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if cleanText == "" then return nil end

    local cacheKey = tostring(srcLang) .. "_" .. tostring(tgtLang) .. "_" .. cleanText:lower()
    if BEN_TRANSLATE_CACHE[cacheKey] then
        return BEN_TRANSLATE_CACHE[cacheKey]
    end

    -- Fast local dictionary lookup for 0ms response
    local lowerClean = cleanText:lower()
    if tgtLang == "id" and BEN_QUICK_EN_TO_ID[lowerClean] then
        local res = BEN_QUICK_EN_TO_ID[lowerClean]
        BEN_TRANSLATE_CACHE[cacheKey] = res
        return res
    elseif (tgtLang == "en" or tgtLang == "auto") and BEN_QUICK_ID_TO_EN[lowerClean] then
        local res = BEN_QUICK_ID_TO_EN[lowerClean]
        BEN_TRANSLATE_CACHE[cacheKey] = res
        return res
    end

    cleanText = BenExpandSlang(cleanText)
    local encoded = BenUrlEncode(cleanText)

    local function cleanResult(str)
        if not str or str == "" then return nil end
        str = str:gsub("\\u([0-9a-fA-F]{4})", function(h)
            local code = tonumber(h, 16)
            if code and code < 256 then return string.char(code) end
            return ""
        end)
        str = str:gsub('\\"', '"'):gsub("\\n", " "):gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">")
        str = str:gsub("^%s+", ""):gsub("%s+$", "")
        return str ~= "" and str or nil
    end

    -- 1. Google Chrome Extension Translate API (Fastest and most open)
    local gUrl = "https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=" .. srcLang .. "&tl=" .. tgtLang .. "&q=" .. encoded
    local raw = nil
    if MakeRequest then
        local ok, res = pcall(MakeRequest, gUrl, "GET", { ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" }, "")
        if ok and res then
            raw = type(res) == "table" and (res.body or res.Body or res.content or res[1] or res.data) or res
        end
    end

    if raw and type(raw) == "string" and raw ~= "" then
        local gTrans = raw:match('^%s*%[%s*"(.-)"') or raw:match('^%s*%[%s*%[%s*"(.-)"') or raw:match('^%s*%[%s*%[%s*%[%s*"(.-)"') or raw:match('"([^"\\]+)"')
        gTrans = cleanResult(gTrans)
        if gTrans then
            BEN_TRANSLATE_CACHE[cacheKey] = gTrans
            return gTrans
        end
    end

    -- 2. Fallback to Google Single API
    local gUrl2 = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=" .. srcLang .. "&tl=" .. tgtLang .. "&dt=t&q=" .. encoded
    raw = nil
    if MakeRequest then
        local ok, res = pcall(MakeRequest, gUrl2, "GET", { ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" }, "")
        if ok and res then
            raw = type(res) == "table" and (res.body or res.Body or res.content or res[1] or res.data) or res
        end
    end

    if raw and type(raw) == "string" and raw ~= "" then
        local gTrans = raw:match('%[%[%["(.-)"%s*,') or raw:match('%[%[%["([^"]+)"') or raw:match('^%s*%[%s*%[%s*%[%s*"(.-)"')
        gTrans = cleanResult(gTrans)
        if gTrans then
            BEN_TRANSLATE_CACHE[cacheKey] = gTrans
            return gTrans
        end
    end

    -- 3. Fallback to MyMemory API
    local sL = (srcLang == "auto") and "en" or srcLang
    local mUrl = "https://api.mymemory.translated.net/get?q=" .. encoded .. "&langpair=" .. sL .. "|" .. tgtLang
    raw = nil
    if MakeRequest then
        local ok, res = pcall(MakeRequest, mUrl, "GET", { ["User-Agent"] = "Mozilla/5.0" }, "")
        if ok and res then
            raw = type(res) == "table" and (res.body or res.Body or res.content or res[1] or res.data) or res
        end
    end

    if raw and type(raw) == "string" and raw ~= "" then
        local trans = raw:match('"translatedText"%s*:%s*"([^"]+)"')
        trans = cleanResult(trans)
        if trans then
            BEN_TRANSLATE_CACHE[cacheKey] = trans
            return trans
        end
    end
    return nil
end

function DoTranslateAndSend(text, srcLang, tgtLang, prefix)
    prefix = prefix or "action|input\ntext|"
    local cleanText = tostring(text or ""):gsub("[\r\n]", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if cleanText == "" then return end

    RunThread(function()
        TextOverlay("`e[Translating...] `w" .. cleanText)
        local trans = TranslateText(cleanText, srcLang, tgtLang)
        if trans and trans ~= "" then
            LogToConsole("`b[`cBen `#x `9Rich `2TR`b] `7[`w" .. (srcLang or "auto"):upper() .. " `2-> `w" .. (tgtLang or "auto"):upper() .. "`7] `w" .. cleanText .. " `2=> `#" .. trans)
            TextOverlay("`2[TR] `#" .. trans)
            SendPacket(2, prefix .. trans)
        else
            TextOverlay("`4[TR Failed] Sending original text...")
            SendPacket(2, prefix .. cleanText)
        end
    end)
end

function HandleBenMenuTranslate(str)
    local prefix, text = GetBenChatText(str)
    if not prefix or not text or text == "" or text:sub(1, 1) == "/" then
        return false
    end

    if benAutoTranslateMode == "off" or not benAutoTranslateMode then
        return false
    end

    local src, tgt = "id", "en"
    if benAutoTranslateMode == "en" then
        src, tgt = "id", "en"
    elseif benAutoTranslateMode == "id" then
        src, tgt = "en", "id"
    elseif benAutoTranslateMode == "auto" then
        src, tgt = DetectLangIdOrEn(text)
    end

    DoTranslateAndSend(text, src, tgt, prefix)
    return true
end

