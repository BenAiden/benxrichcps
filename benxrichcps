function GetInventoryItemId(item)
    if type(item) ~= "table" then
        return tonumber(item)
    end

    fields = { "id", "itemID", "itemId", "itemid", "item_id", "value", "item", "itemValue" }
    for _, field in pairs(fields) do
        id = tonumber(item[field])
        if id and id ~= 0 then
            return id
        end
    end

    return nil
end

function GetInventoryItemAmount(item)
    if type(item) ~= "table" then
        return 0
    end

    fields = { "amount", "count", "cnt", "qty", "quantity", "item_count", "itemCount", "item_amount", "stack" }
    for _, field in pairs(fields) do
        amount = tonumber(item[field])
        if amount and amount > 0 then
            return amount
        end
    end

    return 0
end

function AddItemIdVariant(variants, seen, id)
    id = tonumber(id)
    if id and id ~= 0 and not seen[id] then
        seen[id] = true
        variants[#variants + 1] = id
    end
end

function GetItemIdVariants(id)
    local variants = {}
    local seen = {}
    local value = tonumber(id)
    if not value or value == 0 then
        return variants
    end

    AddItemIdVariant(variants, seen, value)

    return variants
end

function IsSameItemId(a, b)
    local aNumber = tonumber(a)
    local bNumber = tonumber(b)
    if not aNumber or not bNumber then
        return tostring(a or "") == tostring(b or "")
    end

    for _, variant in pairs(GetItemIdVariants(aNumber)) do
        if variant == bNumber then
            return true
        end
    end

    for _, variant in pairs(GetItemIdVariants(bNumber)) do
        if variant == aNumber then
            return true
        end
    end

    return false
end

function NormalizeDropItemId(id, inventoryId)
    local requestedId = tonumber(id)
    local actualId = tonumber(inventoryId)

    if requestedId and requestedId ~= 0 then
        return requestedId
    end

    if actualId and actualId ~= 0 then
        return actualId
    end

    return id
end

function FindInventoryItemStack(id)
    for _, item in pairs(GetInventory and GetInventory() or {}) do
        local itemId = GetInventoryItemId(item)
        if itemId and IsSameItemId(itemId, id) then
            return itemId, GetInventoryItemAmount(item)
        end
    end
    return nil, 0
end

function getItemCount(id)
    local _, amount = FindInventoryItemStack(id)
    return amount or 0
end

function inv(id)
    if not id then return 0 end
    local count = getItemCount(id)
    if count and count > 0 then return count end
    local ok, res = pcall(function()
        local list = GetInventory and GetInventory()
        if not list then return 0 end
        for _, item in pairs(list) do
            local itemId = item and (item.id or item.itemID or item.itemid or item.itemId)
            if itemId and tonumber(itemId) == tonumber(id) then
                return tonumber(item.amount or item.count or item.value) or 0
            end
        end
        return 0
    end)
    return ok and (res or 0) or 0
