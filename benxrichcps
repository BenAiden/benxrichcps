function FloatTeleportTo(targetX, targetY, delay)
    targetX = math.floor(tonumber(targetX) or 0)
    targetY = math.floor(tonumber(targetY) or 0)
    delay = tonumber(delay) or floatDelay or 80

    if not floatRunning or floatStopRequested then return false end

    local loc = GetLocal and GetLocal()
    if not loc or not loc.pos then return false end

    local curX = math.floor(loc.pos.x / 32)
    local curY = math.floor(loc.pos.y / 32)
    if curX == targetX and curY == targetY then return true end

    local path = FindSafePath(curX, curY, targetX, targetY, 1000)
    if path and #path > 0 then
        for i, pos in ipairs(path) do
            if not floatRunning or floatStopRequested then return false end
            if i > 1 then
                GoPath(3, 1, 0, pos.x, pos.y)
                GoPath(nil, nil, nil, pos.x, pos.y)
                Sleep(delay)
            end
        end
        return true
    end

    local candPath, cx, cy = FindNearestReachable(targetX, targetY, 10, curX, curY)
    if candPath and #candPath > 0 then
        for i, pos in ipairs(candPath) do
            if not floatRunning or floatStopRequested then return false end
            if i > 1 then
                GoPath(3, 1, 0, pos.x, pos.y)
                GoPath(nil, nil, nil, pos.x, pos.y)
                Sleep(delay)
            end
        end
        return true
    end

    return false
end

function CollectFloatingObjects(targetId, maxInventory)
    targetId = tonumber(targetId) or 0
    maxInventory = maxInventory or 250
    if not GetObjectList then return false end

    local foundAny = false
    local list = GetObjectList()
    for _, obj in pairs(list) do
        if floatStopRequested or not floatRunning then break end
        if targetId == 0 or obj.id == targetId then
            foundAny = true
            local x1 = math.floor(obj.pos.x / 32)
            local y1 = math.floor(obj.pos.y / 32)
            local remX = obj.pos.x % 32

            -- 1. Step to primary tile position where item is
            FloatTeleportTo(x1, y1, floatDelay)
            Sleep(25)

            -- 2. If item sits horizontally between x1 and x1 + 1, step to x1 + 1 on SAME Y-level
            if remX > 4 and (targetId == 0 or GetFloatInventoryCount(targetId) < maxInventory) then
                if IsTileWalkable(x1 + 1, y1) then
                    FloatTeleportTo(x1 + 1, y1, floatDelay)
                    Sleep(25)
                end
            end

            if targetId > 0 and GetFloatInventoryCount(targetId) >= maxInventory then
                break
            end
        end
    end
    return foundAny
end

