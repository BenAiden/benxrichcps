function FloatTrashWorker()
    floatRunning = true
    floatStopRequested = false
    floatCollectedTotal = 0
    floatCyclesTotal = 0
    if ChangeValue then
        ChangeValue("[C] Modfly", true)
        ChangeValue("[C] Ghost mode", false)
    end

    local ItemIDs = ParseTrashIDList(floatTrashList)
    if #ItemIDs == 0 then
        table.insert(ItemIDs, 1360)
    end

    TextOverlay("`2[FLOAT] Started Float -> Auto Trash Cleaner!")
    LogToConsole("`b[`cBen `#x `9Rich `2FLOAT`b] `2Float -> Trash started for IDs: " .. tostring(floatTrashList or "1360"))

    local function trashitems()
        for _, trashID in ipairs(ItemIDs) do
            local amount = GetFloatInventoryCount(trashID)
            if amount >= 250 then
                LogToConsole("`b[`cBen `#x `9Rich `4FLOAT`b] `4Trashing item " .. trashID .. " amount 250")
                SendPacket(2, "action|dialog_return\ndialog_name|trash\nitem_trash|" .. trashID .. "|\nitem_count|250")
                Sleep(200)
                floatCollectedTotal = floatCollectedTotal + 250
                floatCyclesTotal = floatCyclesTotal + 1
                TextOverlay("`4[FLOAT] Trashed 250x Item ID `#" .. trashID .. "! (Total: `#" .. floatCollectedTotal .. ")")
            end
        end
    end

    local function takeitems()
        local foundInCycle = false
        for _, targetID in ipairs(ItemIDs) do
            if floatStopRequested or not floatRunning then break end

            if GetFloatInventoryCount(targetID) < 250 then
                local itemFound = false
                if GetObjectList then
                    local objList = GetObjectList()
                    if objList then
                        for _, obj in pairs(objList) do
                            if floatStopRequested or not floatRunning then break end
                            if obj.id == targetID then
                                itemFound = true
                                foundInCycle = true
                                local x = math.floor(obj.pos.x / 32)
                                local y = math.floor(obj.pos.y / 32)
                                local remX = obj.pos.x % 32

                                FloatTeleportTo(x, y, floatDelay)
                                Sleep(50)

                                if remX > 4 and GetFloatInventoryCount(targetID) < 250 then
                                    if IsTileWalkable(x + 1, y) then
                                        FloatTeleportTo(x + 1, y, floatDelay)
                                        Sleep(50)
                                    end
                                end

                                if GetFloatInventoryCount(targetID) >= 250 then
                                    LogToConsole("`b[`cBen `#x `9Rich `2FLOAT`b] `2Item " .. targetID .. " is full in inventory")
                                    break
                                end
                            end
                        end
                    end
                end
                if not itemFound then
                    -- not found in world
                end
                Sleep(100)
            else
                LogToConsole("`b[`cBen `#x `9Rich `2FLOAT`b] `2Item " .. targetID .. " full (" .. GetFloatInventoryCount(targetID) .. ")")
            end
        end
        return foundInCycle
    end

    while floatRunning and not floatStopRequested do
        local found = takeitems()
        if floatStopRequested or not floatRunning then break end
        Sleep(500)

        trashitems()
        if floatStopRequested or not floatRunning then break end
        Sleep(500)

        -- If no floating trash items left in world, clean up remaining inventory
        if not found and not floatStopRequested then
            for _, trashID in ipairs(ItemIDs) do
                local remAmount = GetFloatInventoryCount(trashID)
