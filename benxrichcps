function GenerateBenRandomString(length)
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local out = ""
    for i = 1, length or 16 do
        local n = math.random(1, #chars)
        out = out .. chars:sub(n, n)
    end
    return out
end

function GetBenChatText(str)
    if type(str) ~= "string" then
        return nil, nil
    end

    prefix = "action|input\ntext|"
    if str:sub(1, #prefix) == prefix then
        return prefix, str:sub(#prefix + 1)
    end

    prefix = "action|input\n|text|"
    if str:sub(1, #prefix) == prefix then
        return prefix, str:sub(#prefix + 1)
    end

    return nil, nil
end

function GetBenCommand(str)
    local _, text = GetBenChatText(str)
    if not text then
        text = str:match("action|input\ntext|([^\r\n]+)") or str:match("action|input\n|text|([^\r\n]+)")
    end
    if not text then
        return nil, nil
    end

    local clean = tostring(text):gsub("[\r\n]", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local command, args = clean:match("^(%/%S+)%s*(.*)$")
    if command then
        return command:lower(), args or ""
    end

    return nil, nil
end

function BenRunCalculatorArgs(args)
    local a, op, b = tostring(args or ""):match("^%s*([%-%.%d]+)%s*([%+%-%*/x:])%s*([%-%.%d]+)%s*$")
    a = tonumber(a)
    b = tonumber(b)
    if not a or not b or not op then
        BenMenuNotify("`4[CALC] Use /calcu 1 + 2")
        return true
    end

    result = nil
    if op == "+" then
        result = a + b
    elseif op == "-" then
        result = a - b
    elseif op == "*" or op == "x" then
        result = a * b
    elseif op == "/" or op == ":" then
        if b == 0 then
            BenMenuNotify("`4[CALC] Can't divide by 0.")
            return true
        end
        result = a / b
    end

    if result then
        text = "`9Calculated `0: `4" .. a .. " `0" .. op .. " `4" .. b .. " `9Result is `2" .. result
        BenAddBananaLog("calc", text)
        SendPacket(2, "action|input\ntext|" .. text)
        BenMenuNotify(text)
    end
    return true
end

