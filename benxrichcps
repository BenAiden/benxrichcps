        LogToConsole("`b[`cBen `#x `9Rich`b] `4[Mag Scanner] No Magplants found with Background ID: " .. tostring(magScanBackgroundID))
        return
    end

    magScanRunning = true
    magScanCurrentStock = {}
    magScanTotalMags = #mags

    local startTileX, startTileY = GetLocalTile()
    local durationEst = math.ceil((#mags * ((magScanDelay * 2) + 80)) / 1000)

