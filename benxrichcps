function UpdateFarmRangeFromDialog(str)
    local range = str:match("farmrange|(%d+)")
    if range then
        farmRange = tonumber(range) or 1
        if farmRange < 1 then farmRange = 1 end
        if farmRange > 10 then farmRange = 10 end
        if farmNextOffset > farmRange then farmNextOffset = 1 end
        SaveFarmState()
    end
end

function UpdateFarmRemoteFromDialog(str)
    local bgId = str:match("farmremotebg|([^\n]*)")
    if bgId then
        local newBgId = tonumber(bgId) or 0
        if newBgId ~= farmRemoteBgId then
            farmRemoteBlockedMagplants = {}
        end
        farmRemoteBgId = newBgId
        SaveFarmState()
    end

    local minStock = str:match("farmremotemin|([^\n]*)")
    if minStock then
        farmRemoteMinStock = tonumber(minStock) or 1
        if farmRemoteMinStock < 1 then farmRemoteMinStock = 1 end
        SaveFarmState()
    end

    local webhookUrl1 = str:match("farmwebhookurl_1|([^\n]*)") or ""
    local webhookUrl2 = str:match("farmwebhookurl_2|([^\n]*)") or ""
    local webhookUrl3 = str:match("farmwebhookurl_3|([^\n]*)") or ""
    if webhookUrl1 ~= "" or webhookUrl2 ~= "" or webhookUrl3 ~= "" then
        farmWebhookUrl = webhookUrl1 .. webhookUrl2 .. webhookUrl3
        SaveFarmState()
    end

    local discordId = str:match("farmdiscordid|([^\n]*)")
    if discordId then
        farmDiscordID = discordId
        SaveFarmState()
    end

    if str:find("toggle_farm_autoremote|1") then
        farmAutoRemote = true
    elseif str:find("toggle_farm_autoremote|0") then
        farmAutoRemote = false
    end

    if str:find("toggle_farm_vertical|1") then
        farmVerticalPNB = true
        VerticalPNB = true
    elseif str:find("toggle_farm_vertical|0") then
        farmVerticalPNB = false
        VerticalPNB = false
    end

    if str:find("toggle_farm_mirror|1") then
        farmMirrorPNB = true
        MirrorPNB = true
    elseif str:find("toggle_farm_mirror|0") then
        farmMirrorPNB = false
        MirrorPNB = false
    end

    if str:find("toggle_farm_consume|1") then
        farmAutoConsume = true
    elseif str:find("toggle_farm_consume|0") then
        farmAutoConsume = false
    end
    
    if str:find("toggle_farm_webhook|1") then
        farmWebhook = true
    elseif str:find("toggle_farm_webhook|0") then
        farmWebhook = false
    end

    if str:find("toggle_farm_public|1") then
        farmPublicPNB = true
    elseif str:find("toggle_farm_public|0") then
