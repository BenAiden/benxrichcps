    end

    local stateVal = (itemId == 32 or itemId == WRENCH_ID) and 32 or 0
    if SendPacketRaw then
        local success = pcall(function()
            SendPacketRaw(false, {
                type = 3,
                state = stateVal,
                value = itemId,
                px = targetX,
                py = targetY,
                x = targetX * 32,
                y = targetY * 32
            })
        end)
        if not success then
            pcall(function()
                SendPacketRaw({
                    type = 3,
                    state = stateVal,
                    value = itemId,
                    px = targetX,
                    py = targetY,
                    x = targetX * 32,
