function WaitForItemCount(id, amount, attempts)
    local tries = 0
    while amount and amount > 0 and getItemCount(id) < amount and tries < attempts do
        Sleep(100)
        tries = tries + 1
    end
    return not amount or amount <= 0 or getItemCount(id) >= amount
end

function DropItemUntilGone(id)
    local tries = 0
    while getItemCount(id) > 0 and tries < 5 do
        local before = getItemCount(id)
        DropItem(id, before)

        local wait = 0
        while getItemCount(id) >= before and wait < 20 do
            Sleep(100)
            wait = wait + 1
        end

        tries = tries + 1
    end

    return getItemCount(id)
end

function SafeTeleportKey(x, y)
    return tostring(math.floor(tonumber(x) or 0)) .. "," .. tostring(math.floor(tonumber(y) or 0))
end

function SafeTeleportBlockedKey(x, y)
    return GetCurrentWorldName() .. ":" .. SafeTeleportKey(x, y)
end

function IsSafeTeleportTempBlocked(x, y)
    local key = SafeTeleportBlockedKey(x, y)
    local untilTime = safeTeleportBlockedTiles[key]
    if not untilTime then
        return false
    end

    if os.clock() > untilTime then
        safeTeleportBlockedTiles[key] = nil
        return false
    end

    return true
end

function MarkSafeTeleportBlocked(x, y)
    safeTeleportBlockedTiles[SafeTeleportBlockedKey(x, y)] = os.clock() + 8
end

function GetSafeTeleportTile(tileMap, x, y)
    if not tileMap or not tileMap.tiles then
        return nil
    end

    return tileMap.tiles[SafeTeleportKey(x, y)]
end

function ReadSafeTeleportCollisionValue(info)
    if type(info) ~= "table" then
        return nil
    end

    fields = {
        "collisionType",
        "collision_type",
        "collision",
        "collideType",
        "collision_type_id",
        "tileCollision",
        "tile_collision"
    }

    for _, field in ipairs(fields) do
        if info[field] ~= nil then
            return info[field]
        end
    end

    return nil
end

function IsSafeTeleportCollisionWalkable(value)
    if value == nil then
        return nil
    end

    numberValue = tonumber(value)
    if numberValue ~= nil then
        return SAFE_TELEPORT_PASSABLE_COLLISION_TYPES[numberValue] == true
    end

    if type(value) == "string" then
        text = value:lower()
        if text:find("no collision", 1, true)
            or text:find("none", 1, true)
            or text:find("platform", 1, true)
            or text:find("collision on top", 1, true)
            or text:find("gateway", 1, true) then
            return true
        end

        if text:find("solid", 1, true) or text:find("full collision", 1, true) then
            return false
        end
    end

    return nil
end

function GetSafeTeleportItemInfo(itemId)
    itemId = tonumber(itemId) or 0
    if itemId <= 0 then
        return nil
    end

    getter = rawget(_G, "GetItemInfo") or rawget(_G, "getItemInfo")
    if type(getter) ~= "function" then
        return nil
    end

    ok, info = pcall(getter, itemId)
    if ok then
        return info
    end

    return nil
end

function IsSafeTeleportItemWalkable(fg)
    fg = tonumber(fg) or 0
    if fg == 0 or SAFE_TELEPORT_PASSABLE_FG_IDS[fg] == true then
        return true
    end

    if safeTeleportItemWalkableCache[fg] ~= nil then
        return safeTeleportItemWalkableCache[fg]
    end

    if safeTeleportItemCollisionCache[fg] ~= nil then
        cachedWalkable = IsSafeTeleportCollisionWalkable(safeTeleportItemCollisionCache[fg])
        if cachedWalkable ~= nil then
            safeTeleportItemWalkableCache[fg] = cachedWalkable
            return cachedWalkable
        end
    end

    info = GetSafeTeleportItemInfo(fg)
    collision = ReadSafeTeleportCollisionValue(info)
    if collision ~= nil then
        safeTeleportItemCollisionCache[fg] = collision
        walkable = IsSafeTeleportCollisionWalkable(collision)
        if walkable ~= nil then
            safeTeleportItemWalkableCache[fg] = walkable
            return walkable
        end
    end

    return nil
end

function PrimeSafeTeleportAllItems()
    if safeTeleportAllItemsPrimed then
        return
    end
    safeTeleportAllItemsPrimed = true

    getter = rawget(_G, "GetItems") or rawget(_G, "getItems") or rawget(_G, "GetItemList") or rawget(_G, "getItemList")
    if type(getter) ~= "function" then
        return
    end

    ok, items = pcall(getter)
    if not ok or type(items) ~= "table" then
        return
    end

    for _, item in pairs(items) do
        if type(item) == "table" then
            itemId = tonumber(item.id or item.itemID or item.itemId or item.item_id)
            if itemId and itemId > 0 then
                collision = ReadSafeTeleportCollisionValue(item)
                if collision ~= nil then
                    safeTeleportItemCollisionCache[itemId] = collision
                    walkable = IsSafeTeleportCollisionWalkable(collision)
                    if walkable ~= nil then
                        safeTeleportItemWalkableCache[itemId] = walkable
                    end
                end
            end
        end
    end
end

function PrimeSafeTeleportCollisionCache(tileMap)
    PrimeSafeTeleportAllItems()

    if not tileMap or not tileMap.tiles then
        return
    end

    seen = {}
    for _, tile in pairs(tileMap.tiles) do
        fg = tonumber(tile.fg) or 0
        if fg > 0 and not seen[fg] then
            seen[fg] = true
            IsSafeTeleportItemWalkable(fg)
        end
    end
end

function LearnSafeTeleportWalkResult(tileMap, tileX, tileY, moved)
    local tile = GetSafeTeleportTile(tileMap, tileX, tileY)
    if not tile then
        return
    end

    fg = tonumber(tile.fg) or 0
    if fg <= 0 then
        return
    end

    if moved then
        safeTeleportItemWalkableCache[fg] = true
    else
        MarkSafeTeleportBlocked(tileX, tileY)
    end
end

function BuildSafeTeleportMap()
    local ok, tiles = pcall(GetTiles)
    if not ok or type(tiles) ~= "table" then
        return nil
    end

    map = {
        tiles = {},
        minX = nil,
        maxX = nil,
        minY = nil,
        maxY = nil
    }

    for _, tile in pairs(tiles) do
        x = tonumber(tile.x)
        y = tonumber(tile.y)
        if x and y then
            x = math.floor(x)
            y = math.floor(y)
            map.tiles[SafeTeleportKey(x, y)] = {
                fg = tonumber(tile.fg) or 0,
                bg = tonumber(tile.bg) or 0
            }

            map.minX = map.minX and math.min(map.minX, x) or x
            map.maxX = map.maxX and math.max(map.maxX, x) or x
            map.minY = map.minY and math.min(map.minY, y) or y
            map.maxY = map.maxY and math.max(map.maxY, y) or y
        end
    end

    if not map.minX then
        return nil
    end

    PrimeSafeTeleportCollisionCache(map)
    return map
end

function IsSafeTeleportPassable(tileMap, x, y, startX, startY)
    x = math.floor(tonumber(x) or 0)
    y = math.floor(tonumber(y) or 0)

    if x == startX and y == startY then
        return true
    end

    if IsSafeTeleportTempBlocked(x, y) then
        return false
    end

    if not tileMap or not tileMap.tiles then
        return false
    end

    tile = GetSafeTeleportTile(tileMap, x, y)
    if not tile then
        return false
    end

    fg = tonumber(tile.fg) or 0
    itemWalkable = IsSafeTeleportItemWalkable(fg)
    return itemWalkable == true
end

function IsSafeTeleportDoorTile(tileMap, x, y)
    if not tileMap or not tileMap.tiles then
        return false
    end

    tile = GetSafeTeleportTile(tileMap, x, y)
    if not tile then
        return false
    end

    fg = tonumber(tile.fg) or 0
    return fg ~= 0 and IsSafeTeleportItemWalkable(fg) == true
end

function IsSafeTeleportEmptyTile(tileMap, x, y, startX, startY)
    x = math.floor(tonumber(x) or 0)
    y = math.floor(tonumber(y) or 0)

    if x == startX and y == startY then
        return true
    end

    if not tileMap or not tileMap.tiles then
        return false
    end

    tile = GetSafeTeleportTile(tileMap, x, y)
    return tile ~= nil and (tonumber(tile.fg) or 0) == 0
end

function IsSafeTeleportForwardTile(startX, startY, targetX, targetY, x, y)
    startX = math.floor(tonumber(startX) or 0)
    startY = math.floor(tonumber(startY) or 0)
    targetX = math.floor(tonumber(targetX) or startX)
    targetY = math.floor(tonumber(targetY) or startY)
    x = math.floor(tonumber(x) or startX)
    y = math.floor(tonumber(y) or startY)

    local deltaX = targetX - startX
    local deltaY = targetY - startY

    if deltaY < 0 and y > startY then
        return false
    end
    if deltaY > 0 and y < startY then
        return false
    end
    if deltaX < 0 and x > startX then
        return false
    end
    if deltaX > 0 and x < startX then
        return false
    end

    return true
end

function IsSafeTeleportForwardStep(startX, startY, targetX, targetY, nodeX, nodeY, nextX, nextY)
    startX = math.floor(tonumber(startX) or 0)
    startY = math.floor(tonumber(startY) or 0)
    targetX = math.floor(tonumber(targetX) or startX)
    targetY = math.floor(tonumber(targetY) or startY)
    nodeX = math.floor(tonumber(nodeX) or startX)
    nodeY = math.floor(tonumber(nodeY) or startY)
    nextX = math.floor(tonumber(nextX) or nodeX)
    nextY = math.floor(tonumber(nextY) or nodeY)

    local deltaX = targetX - startX
    local deltaY = targetY - startY

    if deltaY < 0 and (nextY > nodeY or nextY > startY) then
        return false
    end
    if deltaY > 0 and (nextY < nodeY or nextY < startY) then
        return false
    end
    if deltaX < 0 and (nextX > nodeX or nextX > startX) then
        return false
    end
    if deltaX > 0 and (nextX < nodeX or nextX < startX) then
        return false
    end

    return true
end

function ResolveSafeTeleportDestination(tileMap, destX, destY, startX, startY, strictDirection, exactTarget)
    destX = math.floor(tonumber(destX) or 0)
    destY = math.floor(tonumber(destY) or 0)
    local useStrictDirection = strictDirection ~= false

    if IsSafeTeleportPassable(tileMap, destX, destY, startX, startY)
        and (not useStrictDirection or IsSafeTeleportForwardTile(startX, startY, destX, destY, destX, destY)) then
        return destX, destY
    end

    if exactTarget == true then
        return nil, nil
    end

    best = nil
    radiusLimit = 8
    for radius = 1, radiusLimit do
        for offsetX = -radius, radius do
            for offsetY = -radius, radius do
                if math.abs(offsetX) + math.abs(offsetY) == radius then
                    x = destX + offsetX
                    y = destY + offsetY
                    if (not useStrictDirection or IsSafeTeleportForwardTile(startX, startY, destX, destY, x, y))
                        and IsSafeTeleportPassable(tileMap, x, y, startX, startY) then
                        score = (math.abs(x - startX) + math.abs(y - startY)) * 100 + radius
                        if not best or score < best.score then
                            best = { x = x, y = y, score = score }
                        end
                    end
                end
            end
        end

        if best then
            return best.x, best.y
        end
    end

    return nil, nil
end

function BuildSafeTeleportPath(destX, destY, maxRange, strictDirection, exactTarget)
    local tileMap = BuildSafeTeleportMap()
    if not tileMap then
        return nil
    end

    startX, startY = GetLocalTile()
    useStrictDirection = strictDirection ~= false
    targetX, targetY = ResolveSafeTeleportDestination(tileMap, destX, destY, startX, startY, useStrictDirection, exactTarget == true)
    if not targetX or not targetY then
        return nil
    end

    if startX == targetX and startY == targetY then
        return {}, targetX, targetY
    end

    queue = { { x = startX, y = startY } }
    head = 1
    visited = {}
    parent = {}
    startKey = SafeTeleportKey(startX, startY)
    targetKey = SafeTeleportKey(targetX, targetY)
    visited[startKey] = true

    boundsPad = math.max(4, tonumber(maxRange) or SAFE_TELEPORT_STEP_RANGE)
    minX = (tileMap.minX or 0) - boundsPad
    maxX = (tileMap.maxX or 0) + boundsPad
    minY = (tileMap.minY or 0) - boundsPad
    maxY = (tileMap.maxY or 0) + boundsPad
    found = false
    searched = 0
    maxSearch = 15000
    directions = {
        { x = 1, y = 0 },
        { x = -1, y = 0 },
        { x = 0, y = 1 },
        { x = 0, y = -1 }
    }

    while head <= #queue and searched < maxSearch do
        node = queue[head]
        head = head + 1
        searched = searched + 1

        if SafeTeleportKey(node.x, node.y) == targetKey then
            found = true
            break
        end

        table.sort(directions, function(a, b)
            ax = node.x + a.x
            ay = node.y + a.y
            bx = node.x + b.x
            by = node.y + b.y
            return (math.abs(targetX - ax) + math.abs(targetY - ay)) < (math.abs(targetX - bx) + math.abs(targetY - by))
        end)

        for _, dir in ipairs(directions) do
            nextX = node.x + dir.x
            nextY = node.y + dir.y
            if nextX >= minX and nextX <= maxX and nextY >= minY and nextY <= maxY then
                key = SafeTeleportKey(nextX, nextY)
                if not visited[key]
                    and (not useStrictDirection or IsSafeTeleportForwardStep(startX, startY, targetX, targetY, node.x, node.y, nextX, nextY))
                    and IsSafeTeleportPassable(tileMap, nextX, nextY, startX, startY) then
                    visited[key] = true
                    parent[key] = SafeTeleportKey(node.x, node.y)
                    queue[#queue + 1] = { x = nextX, y = nextY }
                end
            end
        end
    end

    if not found then
        return nil
    end

    reversed = {}
    key = targetKey
    while key and key ~= startKey do
        x, y = key:match("(-?%d+),(-?%d+)")
        reversed[#reversed + 1] = { x = tonumber(x), y = tonumber(y) }
        key = parent[key]
    end

    path = {}
    for i = #reversed, 1, -1 do
        path[#path + 1] = reversed[i]
    end

    return path, targetX, targetY
end

function GetForcedSafeTeleportWaypoints(destX, destY)
    local currentX, currentY = GetLocalTile()
    local deltaX = math.floor(tonumber(destX) or currentX) - currentX
    local deltaY = math.floor(tonumber(destY) or currentY) - currentY
    local stepX = deltaX > 0 and 1 or (deltaX < 0 and -1 or 0)
    local stepY = deltaY > 0 and 1 or (deltaY < 0 and -1 or 0)
    local candidates = {}

    local function addCandidate(dx, dy)
        if dx ~= 0 or dy ~= 0 then
            candidates[#candidates + 1] = { x = currentX + dx, y = currentY + dy }
        end
    end

    if math.abs(deltaX) >= math.abs(deltaY) then
        addCandidate(stepX, 0)
        addCandidate(0, stepY)
    else
        addCandidate(0, stepY)
        addCandidate(stepX, 0)
    end

    return candidates
end

function IsSafeTeleportForceCandidate(tileMap, tileX, tileY, startX, startY)
    if not tileMap then
        return true
    end

    tile = GetSafeTeleportTile(tileMap, tileX, tileY)
    return tile ~= nil
end

function TrySafeTeleportSingleTileMove(tileMap, tileX, tileY, stepDelay)
    local beforeX, beforeY = GetLocalTile()
    local spent = 0

    FindPath(tileX, tileY)
    Sleep(stepDelay)
    spent = spent + stepDelay

    local currentX, currentY = GetLocalTile()
    if currentX ~= beforeX or currentY ~= beforeY then
        LearnSafeTeleportWalkResult(tileMap, tileX, tileY, true)
        return true, spent
    end

    LearnSafeTeleportWalkResult(tileMap, tileX, tileY, false)
    return false, spent
end

function ForceSafeTeleportStep(destX, destY, maxRange, delayMs)
    maxRange = math.max(1, tonumber(maxRange) or SAFE_TELEPORT_STEP_RANGE)
    delayMs = tonumber(delayMs) or SAFE_TELEPORT_STEP_DELAY
    local stepDelay = math.max(120, math.floor(delayMs / maxRange))
    local waited = 0
    local tileMap = BuildSafeTeleportMap()

    for _ = 1, maxRange do
        local beforeX, beforeY = GetLocalTile()
        if beforeX == destX and beforeY == destY then
            return true
        end

        candidates = GetForcedSafeTeleportWaypoints(destX, destY)
        if #candidates == 0 then
            Sleep(stepDelay)
            waited = waited + stepDelay
            return false
        end

        moved = false
        tried = false
        for _, waypoint in ipairs(candidates) do
            if IsSafeTeleportForceCandidate(tileMap, waypoint.x, waypoint.y, beforeX, beforeY) then
                tried = true
                stepMoved, spent = TrySafeTeleportSingleTileMove(tileMap, waypoint.x, waypoint.y, stepDelay)
                waited = waited + (spent or stepDelay)
                currentX, currentY = GetLocalTile()
                if currentX == destX and currentY == destY then
                    return true
                end

                if stepMoved then
                    moved = true
                    break
                end
            end
        end

        if not tried then
            Sleep(stepDelay)
            waited = waited + stepDelay
        end

        if moved then
            tileMap = BuildSafeTeleportMap()
        end

        if not moved then
            while waited < delayMs do
                Sleep(100)
                waited = waited + 100
            end
            return false
        end
    end

    currentX, currentY = GetLocalTile()
    return currentX == destX and currentY == destY
end

