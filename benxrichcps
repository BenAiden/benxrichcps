function FindMagplantsInWorld(bgId)
    local mags = {}
    local bgSearch = tonumber(bgId) or 0
    local worldX = (GetTile and GetTile(199, 199)) and 199 or 99
    local worldY = (GetTile and GetTile(199, 199)) and 199 or 59

    local tiles = (GetTiles and GetTiles()) or {}
    if #tiles > 0 then
        for _, tile in pairs(tiles) do
            if tile and tonumber(tile.fg) == 5638 then
                if bgSearch == 0 or tonumber(tile.bg) == bgSearch then
                    table.insert(mags, { x = tonumber(tile.x) or 0, y = tonumber(tile.y) or 0 })
                end
            end
        end
    else
        for y = worldY, 0, -1 do
            for x = 0, worldX do
                local tile = GetTile and GetTile(x, y)
                if tile and tonumber(tile.fg) == 5638 then
                    if bgSearch == 0 or tonumber(tile.bg) == bgSearch then
                        table.insert(mags, { x = x, y = y })
                    end
                end
            end
        end
    end

    table.sort(mags, function(a, b)
        if a.y == b.y then
            return a.x < b.x
        end
        return a.y < b.y
    end)
    return mags
end

