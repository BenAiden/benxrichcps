        if word == "the" or word == "is" or word == "are" or word == "you" or word == "your" or word == "how" or word == "much" or word == "why" or word == "what" or word == "where" or word == "can" or word == "please" or word == "pls" or word == "have" or word == "want" or word == "sell" or word == "buy" or word == "price" or word == "this" or word == "that" or word == "with" or word == "from" or word == "for" or word == "bro" or word == "friend" then
            englishScore = englishScore + 2
        end
    end

    if indoScore > englishScore then
