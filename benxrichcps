function FindDialogButtonByLabel(dialog, label, fallback)
    if type(dialog) ~= "string" then
        return fallback
    end

    wanted = string.lower(label or "")
    for line in dialog:gmatch("[^\n]+") do
        button = line:match("^%s*add_button[^|]*|([^|]+)|")
        cleanLine = string.lower(Filter(line))
        if button and button ~= "" and button ~= "END_LIST" and cleanLine:find(wanted, 1, true) then
            return button
        end
    end

    return fallback
end

