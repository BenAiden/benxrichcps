function FindChampagneButton(dialog, useBgl)
    if type(dialog) ~= "string" then
        return useBgl and "getchamp2" or "getchamp"
    end

    fallback = nil
    for line in dialog:gmatch("[^\n]+") do
        button = line:match("^%s*add_button[^|]*|([^|]+)|")
        cleanLine = string.lower(Filter(line))
        if button and button ~= "" and button ~= "END_LIST" then
            if cleanLine:find("champ") then
                fallback = fallback or button
            end

            if useBgl and (cleanLine:find("bgl") or cleanLine:find("blue gem")) then
                return button
            end

            if not useBgl and (cleanLine:find("dl") or cleanLine:find("diamond")) then
                return button
            end
        end
    end

    return fallback or (useBgl and "getchamp2" or "getchamp")
end

