BEN_ENC_MARK = "zqx"
BEN_ENC_KEY = "BenxRichProxyBotHax"
BEN_ENC_ALPHA = "abcdefghijklmnopqrstuvwxyz012345"
BEN_ENC_LOOKUP = {}
for benEncI = 1, #BEN_ENC_ALPHA do
    BEN_ENC_LOOKUP[BEN_ENC_ALPHA:sub(benEncI, benEncI)] = benEncI - 1
end

function BenEncBitXor(a, b)
    local res, bit = 0, 1
    a = math.floor(a) % 256
    b = math.floor(b) % 256
    for _ = 1, 8 do
        local ab, bb = a % 2, b % 2
        if ab ~= bb then
            res = res + bit
        end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        bit = bit * 2
    end
    return res
end

function BenEncMaskByte(byte, index)
    local k = BEN_ENC_KEY:byte(((index - 1) % #BEN_ENC_KEY) + 1)
    return BenEncBitXor(byte, BenEncBitXor(k, (index * 7) % 256))
end

function BenEncryptChat(text)
    text = tostring(text or ""):gsub("[\r\n]", " ")
    if text == "" then
        return nil
    end

    local masked = {}
    local sum = 0
    for i = 1, #text do
        local b = text:byte(i)
        sum = sum + b
        masked[i] = BenEncMaskByte(b, i)
    end

    local out = {}
    local buf, bits = 0, 0
    for i = 1, #masked do
        buf = buf * 256 + masked[i]
        bits = bits + 8
        while bits >= 5 do
            bits = bits - 5
            local idx = math.floor(buf / (2 ^ bits)) % 32
            out[#out + 1] = BEN_ENC_ALPHA:sub(idx + 1, idx + 1)
            buf = buf % (2 ^ bits)
        end
    end
    if bits > 0 then
        local idx = (buf * (2 ^ (5 - bits))) % 32
        out[#out + 1] = BEN_ENC_ALPHA:sub(idx + 1, idx + 1)
    end

    local check = sum % 32
    return BEN_ENC_MARK .. BEN_ENC_ALPHA:sub(check + 1, check + 1) .. table.concat(out)
end

function BenDecryptChat(token)
    if type(token) ~= "string" then
        return nil
    end
    if token:sub(1, #BEN_ENC_MARK) ~= BEN_ENC_MARK then
        return nil
    end

    local body = token:sub(#BEN_ENC_MARK + 1)
    if #body < 2 then
        return nil
    end

    local check = BEN_ENC_LOOKUP[body:sub(1, 1)]
    if not check then
        return nil
    end

    local payload = body:sub(2)
    local chars = {}
    local buf, bits, sum = 0, 0, 0
    for i = 1, #payload do
        local idx = BEN_ENC_LOOKUP[payload:sub(i, i)]
        if not idx then
            return nil
        end
        buf = buf * 32 + idx
        bits = bits + 5
        if bits >= 8 then
            bits = bits - 8
            local byte = math.floor(buf / (2 ^ bits)) % 256
            buf = buf % (2 ^ bits)
            local plain = BenEncMaskByte(byte, #chars + 1)
            sum = sum + plain
            chars[#chars + 1] = string.char(plain)
        end
    end

    if #chars == 0 then
        return nil
    end
    if sum % 32 ~= check then
        return nil
    end

    return (table.concat(chars):gsub("[\r\n]", " "))
end

function BenDecryptInText(text)
    if type(text) ~= "string" then
        return nil
    end
    if not text:find(BEN_ENC_MARK, 1, true) then
        return nil
    end

    local changed = false
    local out = text:gsub(BEN_ENC_MARK .. "[a-z0-5]+", function(tok)
        local dec = BenDecryptChat(tok)
        if dec then
            changed = true
            return "`6[EN] `w" .. dec
        end
        return tok
    end)

    if changed then
        return out
    end

    local stripped = text:gsub("`.", "")
    if stripped ~= text and stripped:find(BEN_ENC_MARK, 1, true) then
        local out2 = stripped:gsub(BEN_ENC_MARK .. "[a-z0-5]+", function(tok)
            local dec = BenDecryptChat(tok)
            if dec then
                changed = true
                return "`6[EN] `w" .. dec
            end
            return tok
        end)
        if changed then
            return out2
        end
    end

    return nil
end

