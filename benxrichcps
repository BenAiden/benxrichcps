    localX, localY = GetLocalTile()
    packet = {}
    packet.type = 3
    packet.value = value
    packet.px = tileX
    packet.py = tileY
    packet.x = packetX or (localX * 32)
    packet.y = packetY or (localY * 32)
    SendPacketRaw(false, packet)
    return true
end


