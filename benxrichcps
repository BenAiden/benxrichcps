function StartBenDropAllBackpack()
    local drops = GetInventorySnapshot()
    if #drops == 0 then
        TextOverlay("`4[DROP] Backpack is empty!")
        return
    end

    TextOverlay("`9[Dropall] Started dropping `#" .. #drops .. " `9stacks...")
    RunThread(function()
        pass = 0
        noProgress = 0

        while pass < 8 and noProgress < 2 do
            currentDrops, currentTotal = GetInventorySnapshot()
            if #currentDrops == 0 then
                break
            end

            for _, item in pairs(currentDrops) do
                DropItemFast(item.id, item.amount)
            end

            Sleep(250)
            _, afterTotal = GetInventorySnapshot()
            if afterTotal >= currentTotal then
                noProgress = noProgress + 1
            else
                noProgress = 0
            end
            pass = pass + 1
        end

        _, remaining = GetInventorySnapshot()
        if remaining > 0 then
            TextOverlay("`6[Dropall] Finished with `#" .. remaining .. " `6item(s) still in backpack.")
        else
            TextOverlay("`2[Dropall] Finished dropping all backpack items.")
        end
    end)
end

function ReturnToBenSafeSpot()
    if not benMenuSafe or not benMenuSafeWorld or benMenuSafeWorld == "" then
        return
    end

    currentWorld = GetCurrentWorldName()
    if not currentWorld or currentWorld == "" then
        SendPacket(3, "action|join_request\nname|" .. benMenuSafeWorld .. "\ninvitedWorld|0")
        return
    end

    if currentWorld ~= benMenuSafeWorld then
        SendPacket(3, "action|join_request\nname|" .. benMenuSafeWorld .. "\ninvitedWorld|0")
        return
    end

    if benMenuSafeX and benMenuSafeY then
        x, y = GetLocalTile()
        if x ~= benMenuSafeX or y ~= benMenuSafeY then
            if type(SafeTeleportTo) == "function" then
                SafeTeleportTo(benMenuSafeX, benMenuSafeY)
            else
                FindPath(benMenuSafeX, benMenuSafeY)
            end
        end
    end
end

