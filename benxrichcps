function GetCollectObjectPosition(object)
    if not object then
        return nil, nil, nil, nil
    end

    tileX = tonumber(object.tileX or object.tile_x or object.px)
    tileY = tonumber(object.tileY or object.tile_y or object.py)
    pixelX = nil
    pixelY = nil

    if object.pos then
        pixelX = tonumber(object.pos.x or object.posX or object.x)
        pixelY = tonumber(object.pos.y or object.posY or object.y)
    else
        pixelX = tonumber(object.posX or object.x)
        pixelY = tonumber(object.posY or object.y)
    end

    if not tileX and pixelX then
        if object.pos or object.posX then
            tileX = math.floor(pixelX / 32)
        else
            tileX = PositionToTile(pixelX)
        end
    end

    if not tileY and pixelY then
        if object.pos or object.posY then
            tileY = math.floor(pixelY / 32)
        else
            tileY = PositionToTile(pixelY)
        end
    end

    if not pixelX and tileX then
        pixelX = tileX * 32
    end

    if not pixelY and tileY then
        pixelY = tileY * 32
    end

    if tileX == nil or tileY == nil or pixelX == nil or pixelY == nil then
        return nil, nil, nil, nil
    end

    return tileX, tileY, pixelX, pixelY
end

function ShouldCollectDrop(mode, itemId, distance, customSet)
    if mode == "all" then
        return true
    end
    if distance > collectRange then
        return false
    end
    if mode == "custom" then
        return customSet and customSet[tonumber(itemId)] == true
    end
    return IsCollectLockItem(itemId)
end

function BuildCollectTargets(mode)
    local targets = {}
    if type(GetObjectList) ~= "function" then
        return targets, false
    end

    ok, objects = pcall(GetObjectList)
    if not ok or type(objects) ~= "table" then
        return targets, false
    end

    localX, localY = GetLocalTile()
    customSet = nil
    if mode == "custom" then
        customSet = BuildCollectIdSet(collectCustomIds)
    end

    for _, object in pairs(objects) do
        objectId = GetCollectObjectId(object)
        itemId = GetCollectItemId(object)
        tileX, tileY, pixelX, pixelY = GetCollectObjectPosition(object)

        if objectId and itemId and tileX and tileY then
            distance = math.abs(tileX - localX) + math.abs(tileY - localY)
            if ShouldCollectDrop(mode, itemId, distance, customSet) then
                table.insert(targets, {
                    objectId = objectId,
                    itemId = itemId,
                    tileX = tileX,
                    tileY = tileY,
                    pixelX = pixelX,
                    pixelY = pixelY,
                    distance = distance
                })
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.distance < b.distance
    end)

    return targets, true
end

function GetCollectStats()
    local stats = { total = 0, locks = 0, custom = 0, targets = 0, available = false }
    local allTargets, hasObjects = BuildCollectTargets("all")
    stats.available = hasObjects
    if not hasObjects then
        return stats
    end

    customSet = BuildCollectIdSet(collectCustomIds)
    stats.total = #allTargets
    for _, drop in pairs(allTargets) do
        if drop.distance <= collectRange then
            if IsCollectLockItem(drop.itemId) then
                stats.locks = stats.locks + 1
            end
            if customSet and customSet[tonumber(drop.itemId)] then
                stats.custom = stats.custom + 1
            end
        end
    end

    modeTargets = BuildCollectTargets(collectMode)
    stats.targets = #modeTargets
    return stats
end

function SendCollectPacket(drop)
    if not drop or not drop.objectId then
        return false
    end

    packet = {}
    packet.type = 11
    packet.value = drop.objectId
    packet.x = drop.pixelX or (drop.tileX * 32)
    packet.y = drop.pixelY or (drop.tileY * 32)
    SendPacketRaw(false, packet)
    return true
end

function StartAutoCollect(mode, showOverlay)
    NormalizeCollectSettings()
    collectMode = mode or collectMode or "locks"
    NormalizeCollectSettings()

    if collectMode == "custom" and GetCollectCustomCount() == 0 then
        collectRunning = false
        SaveCollectState()
        TextOverlay("`4[COLLECT] Add custom item IDs first.")
        return
    end

    _, hasObjects = BuildCollectTargets(collectMode)
    if not hasObjects then
        collectRunning = false
        SaveCollectState()
        TextOverlay("`4[COLLECT] Floating item list is not available.")
        return
    end

    if collectRunning and collectThreadRunning then
        SaveCollectState()
        TextOverlay("`2[COLLECT] Mode updated: " .. GetCollectModeText(collectMode))
        return
    end

    collectRunning = true
    collectSent = 0
    SaveCollectState()
    if showOverlay ~= false then
        TextOverlay("`2[COLLECT] Started: " .. GetCollectModeText(collectMode))
    end

    if collectThreadRunning then
        return
    end

    collectThreadRunning = true
    RunThread(function()
        while collectRunning and _G.BEN_CPS_SESSION == BEN_CPS_SESSION do
            NormalizeCollectSettings()
            targets, ok = BuildCollectTargets(collectMode)
            if not ok then
                collectRunning = false
                SaveCollectState()
                TextOverlay("`4[COLLECT] Floating item list became unavailable.")
                break
            end

            sentThisScan = 0
            for _, drop in ipairs(targets) do
                if not collectRunning or _G.BEN_CPS_SESSION ~= BEN_CPS_SESSION then
                    break
                end

                if collectBatchLimit > 0 and sentThisScan >= collectBatchLimit then
                    break
                end

                if SendCollectPacket(drop) then
                    sentThisScan = sentThisScan + 1
                    collectSent = collectSent + 1
                    SaveCollectState()
                end

                Sleep(collectDelay)
            end

            if collectRunning and _G.BEN_CPS_SESSION == BEN_CPS_SESSION then
                Sleep(collectScanDelay)
            end
        end

        collectThreadRunning = false
    end)
end

