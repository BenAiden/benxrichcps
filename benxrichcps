            SafeFindPath(startTileX, startTileY, 550)
            if FindPath then FindPath(startTileX, startTileY, 550) end
            Sleep(300)
        end

        local elapsed = os.time() - scanStart
        magScanRunning = false
        magScanLastTotalMags = #mags
        magScanLastElapsed = elapsed

        magScanLastResults = {}
        for id, data in pairs(magScanCurrentStock) do
