function SafeFindPathStep(destX, destY, maxRange, delayMs, strictDirection, exactTarget)
    destX = math.floor(tonumber(destX) or 0)
    destY = math.floor(tonumber(destY) or 0)
    maxRange = math.max(1, tonumber(maxRange) or SAFE_TELEPORT_STEP_RANGE)
    delayMs = tonumber(delayMs) or SAFE_TELEPORT_STEP_DELAY
    local useStrictDirection = strictDirection ~= false

    local currentX, currentY = GetLocalTile()
    local path, targetX, targetY = BuildSafeTeleportPath(destX, destY, maxRange, strictDirection, exactTarget)
    if not path then
        if not useStrictDirection then
            return ForceSafeTeleportStep(destX, destY, maxRange, delayMs)
        end

        Sleep(delayMs)
        return false
    end

    if currentX == targetX and currentY == targetY then
        return true
    end

    if #path == 0 then
        Sleep(delayMs)
        return false
    end

    steps = math.min(maxRange, #path)
    stepDelay = math.max(120, math.floor(delayMs / math.max(1, maxRange)))
    for index = 1, steps do
        waypoint = path[index]
        if not waypoint then
            break
        end

        beforeX, beforeY = GetLocalTile()
        FindPath(waypoint.x, waypoint.y)
        Sleep(stepDelay)

        currentX, currentY = GetLocalTile()
        if currentX == targetX and currentY == targetY then
            return true
        end

        if currentX == beforeX and currentY == beforeY then
            if not useStrictDirection then
                return ForceSafeTeleportStep(destX, destY, maxRange, delayMs)
            end

            if not (waypoint.x == targetX and waypoint.y == targetY) then
                MarkSafeTeleportBlocked(waypoint.x, waypoint.y)
            end

            waited = stepDelay
            while waited < delayMs do
                Sleep(100)
                waited = waited + 100
            end
            return false
        end
    end

    currentX, currentY = GetLocalTile()
    return currentX == targetX and currentY == targetY
end

function SafeFindPath(destX, destY, maxSteps, maxRange, delayMs, shouldContinue, strictDirection, exactTarget)
    destX = math.floor(tonumber(destX) or 0)
    destY = math.floor(tonumber(destY) or 0)
    maxRange = math.max(1, tonumber(maxRange) or SAFE_TELEPORT_STEP_RANGE)

    local currentX, currentY = GetLocalTile()
    local distance = math.abs(destX - currentX) + math.abs(destY - currentY)
    maxSteps = tonumber(maxSteps) or (math.ceil(distance / maxRange) + 8)

    local lastX = nil
    local lastY = nil
    local stuck = 0

    for _ = 1, maxSteps do
        if shouldContinue and not shouldContinue() then
            return false
        end

        currentX, currentY = GetLocalTile()
        if currentX == destX and currentY == destY then
            return true
        end

        if currentX == lastX and currentY == lastY then
            stuck = stuck + 1
        else
            stuck = 0
        end

        if stuck >= 3 then
            return false
        end

        lastX = currentX
        lastY = currentY
        if SafeFindPathStep(destX, destY, maxRange, delayMs, strictDirection, exactTarget) then
            return true
        end
    end

    currentX, currentY = GetLocalTile()
    return currentX == destX and currentY == destY
end

function SafeTeleportTo(x, y, shouldContinue)
