    end
    return table.concat(chunks)
end

local function _decrypt(payload, key)
    local key_len = #key
    local k_bytes = {}
    for i = 1, key_len do
        k_bytes[i] = string.byte(key, i)
    end

    local out = {}
    local out_count = 0
    local chunks = {}
    local p_len = #payload

    for i = 1, p_len do
        local enc = string.byte(payload, i)
        local k = k_bytes[((i - 1) % key_len) + 1]
        local offset = ((i - 1) * 7 + 13) % 256
        local dec = (enc - k - offset) % 256
        if dec < 0 then dec = dec + 256 end
        out_count = out_count + 1
        out[out_count] = string.char(dec)
        if out_count >= 8000 then
            table.insert(chunks, table.concat(out))
            out = {}
            out_count = 0
        end
    end
    if out_count > 0 then
        table.insert(chunks, table.concat(out))
    end
    return table.concat(chunks)
end

