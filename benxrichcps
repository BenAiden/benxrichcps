function BenExpandSlang(text)
    if not text or text == "" then return "" end
    local out = {}
    for word in tostring(text):gmatch("%S+") do
        local pre, core, post = word:match("^([^%w%s]*)(.-)([^%w%s]*)$")
        if core and core ~= "" then
            local lowerCore = core:lower()
            local expanded = BEN_SLANG_MAP[lowerCore]
            if expanded then
                core = expanded
            end
        end
        table.insert(out, (pre or "") .. (core or word) .. (post or ""))
    end
    return table.concat(out, " ")
end

