    LogToConsole("`b[`cBen `#x `9Rich`b] `2[Mag Scanner] Scanning " .. #mags .. " Magplants (Est. " .. durationEst .. "s)...")

    RunThread(function()
        local scanStart = os.time()
        for index, coord in ipairs(mags) do
